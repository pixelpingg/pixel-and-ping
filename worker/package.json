{
  "name": "pixel-and-ping-worker",
  "version": "1.1.1",
  "private": true,
  "description": "Pixel & Ping backend as a Cloudflare Worker — Hono + D1 + KV. No VPS/Node server required to run this backend.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "d1:migrate:local": "wrangler d1 migrations apply pixelping --local",
    "d1:migrate:remote": "wrangler d1 migrations apply pixelping --remote",
    "d1:create": "wrangler d1 create pixelping",
    "kv:create": "wrangler kv namespace create PIXELPING_KV",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "drizzle-orm": "^0.33.0",
    "hono": "^4.6.3",
    "js-sha256": "^0.11.0",
    "otplib": "^12.0.1",
    "qrcode": "^1.5.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260831.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/qrcode": "^1.5.6",
    "drizzle-kit": "^0.24.2",
    "typescript": "^5.5.4",
    "wrangler": "^4.20.0"
  }
}
